<Project>

	<PropertyGroup>
		<SWalterTestingApplyTestDefaults Condition="'$(SWalterTestingApplyTestDefaults)' == ''">true</SWalterTestingApplyTestDefaults>
		<SWalterTestingEnableGlobalUsings Condition="'$(SWalterTestingEnableGlobalUsings)' == ''">true</SWalterTestingEnableGlobalUsings>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>$(NoWarn);NU1608</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(SWalterTestingApplyTestDefaults)' == 'true' and '$(IsTestProject)' == 'true'">
		<GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">false</GenerateDocumentationFile>
		<IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IsTestProject)' == 'true' and '$(OutputType)' == ''">
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup Condition="'$(IsTestProject)' == 'true' and '$(SWalterTestingEnableGlobalUsings)' == 'true'">
		<Using Include="AutoFixture" />
		<Using Include="AutoFixture.AutoNSubstitute" />
		<Using Include="AutoFixture.Idioms" />
		<Using Include="AutoFixture.Xunit3" />
		<Using Include="SWalter.Testing" />
		<Using Include="SWalter.Testing.Assertions.Microsoft.Extensions.DependencyInjection" />
		<Using Include="AwesomeAssertions" />
		<Using Include="NSubstitute" />
		<Using Include="NSubstitute.Arg" Alias="Arg" />
		<Using Include="NSubstitute.ReturnsExtensions" />
		<Using Include="Xunit" />
	</ItemGroup>

</Project>